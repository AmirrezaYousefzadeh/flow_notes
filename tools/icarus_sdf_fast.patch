       tf_data.compiletf = sys_sdf_annotate_compiletf;
       tf_data.sizetf    = 0;
-      tf_data.user_data = "$sdf_annotate";
+      tf_data.user_data = "$sdf_annotate_fast";
       res = vpi_register_systf(&tf_data);
       vpip_make_systf_system_defined(res);
 }
